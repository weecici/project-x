# =============================================================================
# Crypto Platform — Environment Variables
# =============================================================================
# Copy this file to .env and fill in any non-default values.
# The .env file is git-ignored. Never commit credentials.
# =============================================================================

# -----------------------------------------------------------------------------
# Kafka
# Host-side processes use the EXTERNAL listener on 9094.
# Docker-internal services use INTERNAL on kafka:9092.
# -----------------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_TRADES=raw.trades
KAFKA_TOPIC_KLINES=raw.klines
KAFKA_DLQ_TRADES=raw.trades.dlq
KAFKA_DLQ_KLINES=raw.klines.dlq

# -----------------------------------------------------------------------------
# MinIO / S3 — local lake storage
# Change these to real AWS credentials for cloud deployment.
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_BRONZE=bronze

# -----------------------------------------------------------------------------
# Binance WebSocket (public, no API key required)
# SYMBOLS: JSON-style list of trading-pair symbols (upper-case).
# KLINE_INTERVALS: JSON-style list of kline intervals.
# -----------------------------------------------------------------------------
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443/ws
SYMBOLS=["BTCUSDT","ETHUSDT"]
KLINE_INTERVALS=["1m"]

# -----------------------------------------------------------------------------
# Lake writer flush thresholds
# LAKE_FLUSH_ROWS:    flush after this many buffered records
# LAKE_FLUSH_SECONDS: flush after this many seconds (whichever comes first)
# -----------------------------------------------------------------------------
LAKE_FLUSH_ROWS=1000
LAKE_FLUSH_SECONDS=30

# =============================================================================
# Phase 2 — Batch Backfill + PySpark Silver
# =============================================================================

# -----------------------------------------------------------------------------
# Binance REST API (public; no API key required for kline data)
# BACKFILL_START_DATE: ISO-8601 date; start of historical fetch window
# BACKFILL_END_DATE:   ISO-8601 date; leave empty to default to today (UTC)
# KLINE_INTERVALS:     JSON list of intervals to backfill
# -----------------------------------------------------------------------------
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_API_KEY=

BACKFILL_START_DATE=2024-01-01
BACKFILL_END_DATE=

# -----------------------------------------------------------------------------
# MinIO silver bucket (created by mc-init at compose up)
# -----------------------------------------------------------------------------
MINIO_BUCKET_SILVER=silver

# -----------------------------------------------------------------------------
# PySpark — local[*] standalone mode (no cluster)
# Tune to fit within the ~7–8 GB usable RAM budget (driver + executor = ~2 GB)
# -----------------------------------------------------------------------------
SPARK_DRIVER_MEMORY=1g
SPARK_EXECUTOR_MEMORY=1g
